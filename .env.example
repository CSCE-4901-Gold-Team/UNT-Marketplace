# Environment variables declared in this file are automatically made available to Prisma.
# See the documentation for more detail: https://pris.ly/d/prisma-schema#accessing-environment-variables-from-the-schema

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

# App Configuration
APP_URL="http://localhost:3000"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Database Configuration
DATABASE_URL="postgresql://[DB USERNAME]:[DB PASSWORD]@localhost:5432/[DB NAME]?schema=public"

# Email Configuration (SendGrid)
# Get your API key from https://app.sendgrid.com/settings/api_keys
# Make sure to verify your sender identity at https://app.sendgrid.com/settings/sender_auth
SENDGRID_API_KEY="SG.your-sendgrid-api-key-here"
SENDGRID_FROM_EMAIL="your-verified-sender@example.com"
SENDGRID_FROM_NAME="UNT Marketplace"